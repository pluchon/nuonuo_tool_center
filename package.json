{
  "name": "local-tool-manage",
  "productName": "诺诺的图床",
  "version": "0.1.0",
  "private": true,
  "description": "个人本地图库管理工具",
  "author": "pluchon",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-isolated.mjs",
    "build": "electron-vite build",
    "predist:win": "install-electron",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "postbuild": "node scripts/desktop-shortcut.cjs",
    "shortcut": "node scripts/desktop-shortcut.cjs --create",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run --dir tests/unit",
    "test:e2e": "vitest run --dir tests/e2e --no-file-parallelism --test-timeout 120000",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "ali-oss": "^6.23.0",
    "drizzle-orm": "^0.45.4",
    "exif-reader": "^2.0.3",
    "markdown-it": "^15.0.3",
    "onnxruntime-node": "^1.31.1",
    "openai": "^7.57.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/nunito": "^5.3.0",
    "@types/ali-oss": "^6.16.11",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "element-plus": "^2.14.8",
    "pinia": "^4.1.0",
    "playwright": "^1.65.1",
    "sass-embedded": "^1.93.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
